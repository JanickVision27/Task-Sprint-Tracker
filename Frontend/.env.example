# ---------------------------------------------------------------------------
# Frontend environment variables (Vite)
# ---------------------------------------------------------------------------
# Vite only exposes variables that start with VITE_ to the browser.
# Copy what you need into Frontend/.env.local (git-ignored) for local work, and
# add the same key in Vercel -> Project -> Settings -> Environment Variables for
# production.
#
# IMPORTANT: Vite bakes these values into the JavaScript bundle at BUILD time.
# Editing the value in Vercel does NOT update an existing deployment — you must
# redeploy (Deployments -> ... -> Redeploy) for the change to take effect.

# Base URL of the Spring Boot backend.
#   Local dev   : leave empty/unset — Vite proxies /api and /ws to localhost:8080
#                 (see vite.config.js), so no CORS setup is needed.
#   Production  : the full https URL of the deployed backend, no trailing slash
#                 and no /api suffix (both are normalized automatically):
#                   VITE_API_URL=https://task-sprint-tracker.onrender.com
VITE_API_URL=

# Where the welcome email links point is configured on the BACKEND
# (APP_FRONTEND_URL), not here.
