# ---------------------------------------------------------------------------
# Task & Sprint Tracker — backend environment variables
# ---------------------------------------------------------------------------
# Copy the values you need into your shell, Render dashboard, or Kubernetes Secret.
# NEVER commit the real file (.env / .env.* are git-ignored).
#
# Locally, Spring Boot does not read .env automatically. Either export these before
# `./mvnw spring-boot:run`, or put them in src/main/resources/application-local.properties
# (that file is git-ignored and loaded by the default "local" profile).

# --- Database -----------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/dbname
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT ----------------------------------------------------------------------
JWT_SECRET=replace-with-a-random-value-of-at-least-32-bytes
APP_JWT_EXPIRATION=86400000

# --- CORS ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Brevo transactional email ------------------------------------------------
# Get the v3 key from Brevo -> SMTP & API -> API Keys (starts with "xkeysib-").
BREVO_API_KEY=xkeysib-your-api-key-here
# Must match a verified sender inside Brevo (Settings -> Senders & IP -> Senders).
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=Task & Sprint Tracker
# Optional extras:
# BREVO_API_URL=https://api.brevo.com/v3/smtp/email
# BREVO_ENABLED=true

# --- App links used inside emails --------------------------------------------
# Local dev: http://localhost:5173 · Production: your Vercel URL
APP_FRONTEND_URL=http://localhost:5173

# --- Password reset -----------------------------------------------------------
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
