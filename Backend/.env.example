# Render / Production Environment Variables Example
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example.region.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here
APP_JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_characters
APP_JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app
